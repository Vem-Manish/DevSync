{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend"
    },
    "api": {
      "root": "backend",
      "framework": "fastapi"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api"
    },
    {
      "src": "/(.*)",
      "dest": "web"
    }
  ]
}
